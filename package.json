{
  "name": "nekoroute",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "description": "Public regional availability diagnostics, safe public-domain previews, malware heuristics, and persistent proxy health tracking.",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "build:css": "npx @tailwindcss/cli -i ./src/input.css -o ./public/app.css --minify",
    "build": "npm run build:css"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "http-proxy-agent": "^7.0.2",
    "https-proxy-agent": "^7.0.6",
    "p-limit": "^6.2.0",
    "socks-proxy-agent": "^10.1.0",
    "cheerio": "^1.1.2",
    "sequelize": "^6.37.7",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "tailwindcss": "^4.1.0"
  }
}
